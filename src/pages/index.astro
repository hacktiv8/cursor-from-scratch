---
import "../styles/global.css";
import { INDONESIAN_ZONES, WORLD_ZONES } from "../lib/clock";
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Kala — perbandingan tanggal dan jam WIB, WITA, WIT, dan kota populer di dunia secara real-time."
    />
    <title>Kala — WIB · WITA · WIT · Dunia</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Syne:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="atmosphere" aria-hidden="true"></div>

    <main class="stage">
      <p class="brand">Kala</p>
      <p class="lede">Perbandingan waktu di Indonesia dan kota populer di dunia</p>

      <section
        id="indo-clocks"
        class="indo-clocks"
        aria-label="Waktu Indonesia Barat, Tengah, dan Timur"
      >
        {
          INDONESIAN_ZONES.map((zone) => (
            <article class="zone-clock" data-zone={zone.id}>
              <h2 class="zone-id">{zone.id}</h2>
              <p class="zone-name">{zone.name}</p>
              <time class="clock" datetime="">
                <span data-part="hours">00</span>
                <span class="sep" aria-hidden="true">
                  :
                </span>
                <span data-part="minutes">00</span>
                <span class="sep" aria-hidden="true">
                  :
                </span>
                <span data-part="seconds">00</span>
              </time>
              <p class="date" data-part="date"></p>
              <p class="zone-offset">{zone.offset}</p>
            </article>
          ))
        }
      </section>

      <section
        id="world-clocks"
        class="world-clocks"
        aria-label="Waktu di kota populer di dunia"
      >
        <h2 class="section-title">Kota populer</h2>
        <div class="world-clocks-grid">
          {
            WORLD_ZONES.map((zone) => (
              <article class="zone-clock" data-zone={zone.id}>
                <h2 class="zone-id">{zone.id}</h2>
                <p class="zone-name">{zone.name}</p>
                <time class="clock" datetime="">
                  <span data-part="hours">00</span>
                  <span class="sep" aria-hidden="true">
                    :
                  </span>
                  <span data-part="minutes">00</span>
                  <span class="sep" aria-hidden="true">
                    :
                  </span>
                  <span data-part="seconds">00</span>
                </time>
                <p class="date" data-part="date"></p>
                <p class="zone-offset" data-part="offset"></p>
              </article>
            ))
          }
        </div>
      </section>
    </main>

    <script>
      import "../scripts/start-clock";
    </script>
  </body>
</html>
